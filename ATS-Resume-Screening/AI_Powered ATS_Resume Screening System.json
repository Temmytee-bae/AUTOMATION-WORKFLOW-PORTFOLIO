        "subject": "={{\"ATS Interview Recommendation: \" + $json.candidate_name}}",
        "message": "={{  `<div style=\"margin:0;padding:30px 12px;background-color:#EADCCF;font-family:Arial,Helvetica,sans-serif;\">   <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"max-width:620px;margin:0 auto;background-color:#FFFFFF;border-radius:12px;overflow:hidden;\">      <tr>       <td style=\"background-color:#581B3A;padding:30px 28px;text-align:center;\">         <p style=\"margin:0;color:#E7B9D0;font-size:12px;letter-spacing:2px;font-weight:bold;\">BENEATH THE BITE FOODS LTD.</p>         <h1 style=\"margin:12px 0 5px;color:#FFFFFF;font-size:25px;\">Candidate Screening Report</h1>         <p style=\"margin:0;color:#F1DCE6;font-size:13px;\">Quality Assurance &amp; Quality Control Recruitment</p>       </td>     </tr>      <tr>       <td style=\"padding:25px 28px 12px;\">         <span style=\"display:inline-block;background-color:#F5E6EF;color:#A51D68;padding:8px 14px;border-radius:20px;font-size:12px;font-weight:bold;\">INTERVIEW RECOMMENDATION</span>         <h2 style=\"margin:18px 0 8px;color:#30205F;font-size:21px;\">${$json.candidate_name}</h2>         <p style=\"margin:0;color:#666666;font-size:14px;line-height:1.6;\">A candidate has met the ATS screening criteria and has been recommended for further consideration.</p>       </td>     </tr>      <tr>       <td style=\"padding:15px 28px;\">         <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F8F3EF;border-radius:8px;\">           <tr><td style=\"padding:13px 16px;color:#581B3A;font-size:13px;font-weight:bold;width:40%;\">Email Address</td><td style=\"padding:13px 16px;color:#333333;font-size:13px;\">${$json.email}</td></tr>           <tr><td style=\"padding:13px 16px;color:#581B3A;font-size:13px;font-weight:bold;\">Phone Number</td><td style=\"padding:13px 16px;color:#333333;font-size:13px;\">${$json.phone}</td></tr>           <tr><td style=\"padding:13px 16px;color:#581B3A;font-size:13px;font-weight:bold;\">Qualification</td><td style=\"padding:13px 16px;color:#333333;font-size:13px;\">${$json.highest_qualification}</td></tr>           <tr><td style=\"padding:13px 16px;color:#581B3A;font-size:13px;font-weight:bold;\">Relevant Experience</td><td style=\"padding:13px 16px;color:#333333;font-size:13px;\">${$json.years_of_relevant_experience} years</td></tr>         </table>       </td>     </tr>      <tr>       <td style=\"padding:10px 28px 20px;\">         <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">           <tr>             <td style=\"background-color:#30205F;padding:20px;text-align:center;border-radius:8px;width:50%;\">               <p style=\"margin:0;color:#E5DDF7;font-size:12px;\">ATS MATCH SCORE</p>               <p style=\"margin:8px 0 0;color:#FFFFFF;font-size:30px;font-weight:bold;\">${$json.total_match_score}<span style=\"font-size:15px;\">/100</span></p>             </td>             <td style=\"width:12px;\"></td>             <td style=\"background-color:#F5E6EF;padding:20px;text-align:center;border-radius:8px;width:50%;\">               <p style=\"margin:0;color:#8B245D;font-size:12px;\">SCREENING STATUS</p>               <p style=\"margin:8px 0 0;color:#581B3A;font-size:16px;font-weight:bold;\">${$json.recommendation}</p>             </td>           </tr>         </table>       </td>     </tr>      <tr>       <td style=\"padding:5px 28px 25px;\">         <h3 style=\"margin:0 0 10px;color:#30205F;font-size:16px;\">AI Assessment Summary</h3>         <div style=\"border-left:4px solid #B52D7A;background-color:#FAF5F7;padding:15px;color:#444444;font-size:13px;line-height:1.7;\">           ${$json.ai_assessment}         </div>       </td>     </tr>      <tr>       <td style=\"background-color:#581B3A;padding:22px 28px;text-align:center;\">         <p style=\"margin:0;color:#FFFFFF;font-size:13px;font-weight:bold;\">Recruitment &amp; Human Resources</p>         <p style=\"margin:8px 0 0;color:#EADCCF;font-size:11px;line-height:1.6;\">This report is generated automatically by the ATS screening system. All recommendations require human review before a recruitment decision is made.</p>         <p style=\"margin:15px 0 0;color:#D9B8C9;font-size:10px;\">Beneath the Bite Foods Ltd. | Automated Recruitment Screening</p>       </td>     </tr>    </table> </div>` }}",
